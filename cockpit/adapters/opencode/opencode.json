{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "enabled_providers": [
    "openai"
  ],
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.6-luna",
  "experimental": {
    "disable_paste_summary": true
  },
  "permission": {
    "skill": {
      "*": "ask"
    }
  },
  "agent": {
    "plan": {
      "description": "Inspect the codebase in read-only mode and produce an execution-ready plan.",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "prompt": "{file:./prompts/plan.md}\n\n{file:./prompts/pattern-radar.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "*capture.sh*": "allow"
        },
        "question": "allow",
        "todowrite": "allow",
        "skill": {
          "*": "ask"
        }
      }
    },
    "build": {
      "description": "Default work agent: discuss, diagnose, plan proportionally, implement when authorized, and validate.",
      "mode": "primary",
      "model": "openai/gpt-5.6-terra",
      "prompt": "{file:./prompts/build.md}",
      "variant": "medium",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "*capture.sh*": "allow"
        },
        "question": "allow",
        "todowrite": "allow",
        "skill": {
          "*": "ask"
        }
      }
    },
    "review": {
      "description": "Review changes in strict read-only mode for correctness, regressions, maintainability, and client constraints.",
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "prompt": "{file:./prompts/review.md}\n\n{file:./prompts/pattern-radar.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "*capture.sh*": "allow"
        },
        "question": "allow",
        "todowrite": "allow",
        "skill": {
          "*": "ask"
        }
      }
    },
    "pattern-scan": {
      "description": "On-demand read-only scanner. Invoke when onboarding on an unfamiliar codebase to map its architectural, JavaScript, and framework patterns/anti-patterns. No plan, no changes.",
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.6-terra",
      "variant": "medium",
      "prompt": "{file:./prompts/pattern-scan.md}\n\n{file:./prompts/pattern-radar.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "question": "allow",
        "todowrite": "allow",
        "skill": {
          "*": "ask"
        }
      }
    },
    "general": {
      "description": "General-purpose research and multi-step delegated work that needs broader tools than explore.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-terra",
      "variant": "medium"
    },
    "explore": {
      "description": "Fast bounded read-only discovery across code and documentation.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "variant": "medium"
    }
  }
}
