{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "interactive",
  "enabled_providers": [
    "openai"
  ],
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.6-luna",
  "experimental": {
    "disable_paste_summary": true
  },
  "permission": {
    "skill": {
      "*": "ask"
    }
  },
  "agent": {
    "interactive": {
      "description": "Clarify, challenge, scope, compare options, and decide the next agent without modifying files.",
      "mode": "primary",
      "model": "openai/gpt-5.6-terra",
      "variant": "medium",
      "prompt": "{file:./prompts/interactive.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "*capture.sh*": "allow"
        },
        "question": "allow",
        "todowrite": "deny",
        "task": {
          "*": "deny",
          "product-design": "allow",
          "pattern-scan": "allow",
          "review": "allow"
        },
        "skill": {
          "*": "ask"
        }
      }
    },
    "plan": {
      "description": "Inspect the codebase in read-only mode and produce an execution-ready plan.",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "prompt": "{file:./prompts/plan.md}\n\n{file:./prompts/pattern-radar.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "*capture.sh*": "allow"
        },
        "question": "allow",
        "todowrite": "allow",
        "skill": {
          "*": "ask"
        }
      }
    },
    "design": {
      "description": "Contextual product design mode for content, UX, UI, and no-mockup product needs without modifying files.",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "prompt": "{file:./prompts/product-design.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "*capture.sh*": "allow"
        },
        "question": "allow",
        "todowrite": "allow",
        "task": "deny",
        "skill": {
          "*": "ask"
        }
      }
    },
    "build": {
      "description": "Implement the approved plan with minimal diffs and targeted validation.",
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
      "prompt": "{file:./prompts/build.md}",
      "variant": "medium",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "*capture.sh*": "allow"
        },
        "question": "allow",
        "todowrite": "allow",
        "skill": {
          "*": "ask"
        }
      }
    },
    "review": {
      "description": "Review changes in strict read-only mode for correctness, regressions, maintainability, and client constraints.",
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.6-sol",
      "variant": "high",
      "prompt": "{file:./prompts/review.md}\n\n{file:./prompts/pattern-radar.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "*capture.sh*": "allow"
        },
        "question": "allow",
        "todowrite": "allow",
        "skill": {
          "*": "ask"
        }
      }
    },
    "pattern-scan": {
      "description": "On-demand read-only scanner. Invoke when onboarding on an unfamiliar codebase to map its architectural, JavaScript, and framework patterns/anti-patterns. No plan, no changes.",
      "mode": "subagent",
      "hidden": true,
      "model": "openai/gpt-5.6-terra",
      "variant": "medium",
      "prompt": "{file:./prompts/pattern-scan.md}\n\n{file:./prompts/pattern-radar.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "question": "allow",
        "todowrite": "allow",
        "skill": {
          "*": "ask"
        }
      }
    }
  }
}
