{
  "$schema": "https://opencode.ai/config.json",
  // Copy to ~/.config/opencode-profiles/perso.jsonc and adjust if needed.
  // This profile is for personal projects only.
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 60000,
        "chunkTimeout": 60000
      }
    }
  },
  "agent": {
    "interactive": {
      "model": "openai/gpt-5.5-fast",
      "variant": "low"
    },
    "plan": {
      "model": "openai/gpt-5.5",
      "variant": "high"
    },
    "autopilot": {
      "model": "openai/gpt-5.5",
      "variant": "medium"
    },
    "review": {
      "model": "openai/gpt-5.5",
      "variant": "high"
    },
    "pattern-scan": {
      "model": "openai/gpt-5.5-fast",
      "variant": "medium"
    }
  }
}
