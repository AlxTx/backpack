#!/usr/bin/env sh
set -eu

SCRIPT_PATH=$0
if [ -L "$SCRIPT_PATH" ]; then
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH=$LINK_TARGET ;;
    *) SCRIPT_PATH=$(dirname "$SCRIPT_PATH")/$LINK_TARGET ;;
  esac
fi
SCRIPT_DIR=$(CDPATH= cd "$(dirname "$SCRIPT_PATH")" && pwd -P)

usage() {
  cat <<'EOF'
Usage:
  backpack
  backpack install [engineering|cockpit|machine|everything] [options]
  backpack doctor
  backpack check [component]
  backpack status  # alias for check
  backpack skills
  backpack list
  backpack find <need>
  backpack info <skill>
  backpack add <skill>
  backpack remove <skill>

Examples:
  backpack install engineering
  backpack install engineering --codex
  backpack install engineering --super
  backpack install engineering --all-hosts
  backpack install cockpit --all-hosts  # legacy alias
  backpack install machine
  backpack install everything --personal
  backpack find design
  backpack add impeccable
EOF
}

use_gum() {
  [ -t 0 ] && [ -t 1 ] && command -v gum >/dev/null 2>&1
}

dispatch_main_choice() {
  case "$1" in
    install) exec "$SCRIPT_DIR/bootstrap/install.sh" ;;
    skills)
      "$SCRIPT_DIR/bootstrap/skills.sh" menu
      exec "$SCRIPT_DIR/backpack"
      ;;
    check) exec "$SCRIPT_DIR/bootstrap/check.sh" ;;
    quit) exit 0 ;;
  esac
}

gum_main_menu() {
  gum style \
    --foreground 39 \
    --border-foreground 39 \
    --border rounded \
    --padding '1 2' \
    --margin '1 0' \
    '◆ Backpack' 'Backpack Engineering and machine setup.'

  selection=$(gum choose \
    --header 'What do you want to do?' \
    --cursor '→ ' \
    --selected-prefix '✓ ' \
    --unselected-prefix '  ' \
    'Install or refresh' \
    'Manage project skills' \
    'Check installation' \
    'Quit') || exit 0

  case "$selection" in
    'Install or refresh') dispatch_main_choice install ;;
    'Manage project skills') dispatch_main_choice skills ;;
    'Check installation') dispatch_main_choice check ;;
    'Quit') dispatch_main_choice quit ;;
  esac
}

numbered_main_menu() {
  cat <<'EOF'

◆ Backpack

What do you want to do?

  1  Install or refresh
  2  Manage project skills
  3  Check installation
  q  Quit

EOF
  printf '? Select an option: '
  read choice

  case "$choice" in
    1) dispatch_main_choice install ;;
    2) dispatch_main_choice skills ;;
    3) dispatch_main_choice check ;;
    q|Q) dispatch_main_choice quit ;;
    *)
      printf '✗ invalid choice: %s\n' "$choice" >&2
      exit 2
      ;;
  esac
}

main_menu() {
  if use_gum; then
    gum_main_menu
  else
    numbered_main_menu
  fi
}

case "${1:-}" in
  '') main_menu ;;
  install)
    shift
    exec "$SCRIPT_DIR/bootstrap/install.sh" "$@"
    ;;
  doctor)
    shift
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    exec "$SCRIPT_DIR/bootstrap/doctor.sh"
    ;;
  check)
    shift
    [ "$#" -le 1 ] || { usage >&2; exit 2; }
    exec "$SCRIPT_DIR/bootstrap/check.sh" "$@"
    ;;
  status)
    shift
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    exec "$SCRIPT_DIR/bootstrap/status.sh"
    ;;
  skills)
    shift
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    exec "$SCRIPT_DIR/bootstrap/skills.sh" menu
    ;;
  list|find|info|add|remove)
    exec "$SCRIPT_DIR/bootstrap/skills.sh" "$@"
    ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
