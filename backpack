#!/usr/bin/env sh
set -eu

SCRIPT_PATH=$0
if [ -L "$SCRIPT_PATH" ]; then
  LINK_TARGET=$(readlink "$SCRIPT_PATH")
  case "$LINK_TARGET" in
    /*) SCRIPT_PATH=$LINK_TARGET ;;
    *) SCRIPT_PATH=$(dirname "$SCRIPT_PATH")/$LINK_TARGET ;;
  esac
fi
SCRIPT_DIR=$(CDPATH= cd "$(dirname "$SCRIPT_PATH")" && pwd -P)

usage() {
  cat <<'EOF'
Usage:
  backpack
  backpack install [cockpit|machine|everything] [options]
  backpack doctor
  backpack status
  backpack skills
  backpack list
  backpack find <need>
  backpack info <skill>
  backpack add <skill>
  backpack remove <skill>

Examples:
  backpack install cockpit
  backpack install cockpit --codex
  backpack install cockpit --all-hosts
  backpack install machine
  backpack install everything --personal
  backpack find design
  backpack add impeccable
EOF
}

use_gum() {
  [ -t 0 ] && [ -t 1 ] && command -v gum >/dev/null 2>&1
}

dispatch_main_choice() {
  case "$1" in
    cockpit) exec "$SCRIPT_DIR/bootstrap/install.sh" cockpit ;;
    machine) exec "$SCRIPT_DIR/bootstrap/install.sh" machine ;;
    everything) exec "$SCRIPT_DIR/bootstrap/install.sh" everything ;;
    skills)
      "$SCRIPT_DIR/bootstrap/skills.sh" menu
      exec "$SCRIPT_DIR/backpack"
      ;;
    doctor) exec "$SCRIPT_DIR/bootstrap/doctor.sh" ;;
    status) exec "$SCRIPT_DIR/bootstrap/status.sh" ;;
    quit) exit 0 ;;
  esac
}

gum_main_menu() {
  gum style \
    --foreground 39 \
    --border-foreground 39 \
    --border rounded \
    --padding '1 2' \
    --margin '1 0' \
    '◆ Backpack' 'Cockpit and machine setup.'

  selection=$(gum choose \
    --header 'What do you want to do?' \
    --cursor '→ ' \
    --selected-prefix '✓ ' \
    --unselected-prefix '  ' \
    'Install or update Cockpit' \
    'Install or update this Mac' \
    'Install everything' \
    'Manage project skills' \
    'Check installation' \
    'Show status' \
    'Quit') || exit 0

  case "$selection" in
    'Install or update Cockpit') dispatch_main_choice cockpit ;;
    'Install or update this Mac') dispatch_main_choice machine ;;
    'Install everything') dispatch_main_choice everything ;;
    'Manage project skills') dispatch_main_choice skills ;;
    'Check installation') dispatch_main_choice doctor ;;
    'Show status') dispatch_main_choice status ;;
    'Quit') dispatch_main_choice quit ;;
  esac
}

numbered_main_menu() {
  cat <<'EOF'

◆ Backpack

What do you want to do?

  1  Install or update Cockpit
  2  Install or update this Mac
  3  Install everything
  4  Manage project skills
  5  Check installation
  6  Show status
  q  Quit

EOF
  printf '? Select an option: '
  read choice

  case "$choice" in
    1) dispatch_main_choice cockpit ;;
    2) dispatch_main_choice machine ;;
    3) dispatch_main_choice everything ;;
    4) dispatch_main_choice skills ;;
    5) dispatch_main_choice doctor ;;
    6) dispatch_main_choice status ;;
    q|Q) dispatch_main_choice quit ;;
    *)
      printf '✗ invalid choice: %s\n' "$choice" >&2
      exit 2
      ;;
  esac
}

main_menu() {
  if use_gum; then
    gum_main_menu
  else
    numbered_main_menu
  fi
}

case "${1:-}" in
  '') main_menu ;;
  install)
    shift
    exec "$SCRIPT_DIR/bootstrap/install.sh" "$@"
    ;;
  doctor)
    shift
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    exec "$SCRIPT_DIR/bootstrap/doctor.sh"
    ;;
  status)
    shift
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    exec "$SCRIPT_DIR/bootstrap/status.sh"
    ;;
  skills)
    shift
    [ "$#" -eq 0 ] || { usage >&2; exit 2; }
    exec "$SCRIPT_DIR/bootstrap/skills.sh" menu
    ;;
  list|find|info|add|remove)
    exec "$SCRIPT_DIR/bootstrap/skills.sh" "$@"
    ;;
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
