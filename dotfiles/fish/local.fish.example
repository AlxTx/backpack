# Copy to ~/.config/fish/local.fish. Do not commit local.fish.

# Client/company-specific certificates or proxies.
# set -gx NODE_EXTRA_CA_CERTS "$HOME/.certs/company-root-ca.crt"

# Override default workspace for this machine. Prefer ~/dev, but ~/Dev is OK on
# macOS machines that already have uppercase folder casing.
# set -gx WORKSPACE "$HOME/dev"

# opencode local profiles. Keep real client profiles outside Backpack.
# mkdir -p ~/.config/opencode-profiles
# cp ~/dev/perso/backpack/cockpit/opencode/templates/perso.template.jsonc ~/.config/opencode-profiles/perso.jsonc
# cp ~/dev/perso/backpack/cockpit/opencode/templates/client-copilot.template.jsonc ~/.config/opencode-profiles/chanel.jsonc
# alias ocode-perso='env OPENCODE_CONFIG=$HOME/.config/opencode-profiles/perso.jsonc opencode'
# alias ocode-chanel='env OPENCODE_CONFIG=$HOME/.config/opencode-profiles/chanel.jsonc opencode'
