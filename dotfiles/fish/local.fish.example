# Copy to ~/.config/fish/local.fish. Do not commit local.fish.

# Client/company-specific certificates or proxies.
# set -gx NODE_EXTRA_CA_CERTS "$HOME/.certs/company-root-ca.crt"

# Override default workspace for this machine. Prefer ~/dev, but ~/Dev is OK on
# macOS machines that already have uppercase folder casing.
# set -gx WORKSPACE "$HOME/dev"

# OpenCode local client setup:
# Backpack copies its portable core once to ~/.config/opencode.
# Edit ~/.config/opencode/opencode.json directly for machine/client providers.
# Then launch opencode normally.
