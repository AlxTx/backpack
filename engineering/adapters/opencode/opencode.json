{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/opt/homebrew/bin/fish",
  "default_agent": "build",
  "experimental": {
    "disable_paste_summary": true
  },
  "permission": {
    "skill": {
      "*": "ask",
      "backpack-*": "allow"
    }
  },
  "agent": {
    "plan": {
      "description": "Inspect the codebase in read-only mode and produce an execution-ready plan.",
      "mode": "primary",
      "prompt": "{file:./prompts/plan.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "question": "allow",
        "todowrite": "allow",
        "skill": {
          "*": "ask",
          "backpack-*": "allow"
        }
      }
    },
    "build": {
      "description": "Default work agent: discuss, diagnose, plan proportionally, implement when authorized, and validate.",
      "mode": "primary",
      "prompt": "{file:./prompts/build.md}",
      "permission": {
        "edit": "allow",
        "bash": "ask",
        "question": "allow",
        "todowrite": "allow",
        "skill": {
          "*": "ask",
          "backpack-*": "allow"
        }
      }
    },
    "review": {
      "description": "Review changes in strict read-only mode for correctness, regressions, maintainability, and client constraints.",
      "mode": "subagent",
      "hidden": true,
      "prompt": "{file:./prompts/review.md}",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "question": "allow",
        "todowrite": "allow",
        "skill": {
          "*": "ask"
        }
      }
    },
    "general": {
      "description": "General-purpose research and multi-step delegated work that needs broader tools than explore.",
      "mode": "subagent"
    },
    "explore": {
      "description": "Fast bounded read-only discovery across code and documentation.",
      "mode": "subagent"
    }
  }
}
